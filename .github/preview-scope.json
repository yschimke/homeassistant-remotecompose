    "ha-client",
    "ha-model",
    "integration",
    "previews",
    "quest",
    "rc-card-shutter",
    "rc-components",
    "rc-components-ui",
    "rc-converter",
    "rc-image-coil",
    "rc-material3-motion",
    "rc-mdi-icons",
    "rc-player-ui",
    "room-ui",
    "terrazzo-core",
    "tv",
    "wear",
    "wear-benchmark"
  ],
  "ignorePaths": [
    "docs/**",
    "**/*.md",
    "ios/**",
    "custom_components/**",
    "home-assistant/**",
    "deploy/**",
    "packaging/**",
    "push-relay/**",
    "wall-client/**",
    "embed/**",
    "lovelace-catalog/**",
    "references/**",
    "scripts/**",
    "skills/**",
    ".githooks/**",
    ".idea/**",
    ".vscode/**",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "hacs.json",
    "repository.yaml",
    ".gitignore",
    ".gitattributes",
    "renovate.json"
  ]
}
