<?xml version="1.0" encoding="utf-8"?>
<!--
  TALL — many-row lists, resizable up to about 4x4 cells.
  Every launcher variant starts at 1x1 and can resize in both axes.
  Keep provider identities and maximums so existing installations retain their slots.
  Updates are driven by Home Assistant state changes, not framework polling.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="50dp"
    android:minHeight="50dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:minResizeWidth="50dp"
    android:minResizeHeight="50dp"
    android:maxResizeWidth="300dp"
    android:maxResizeHeight="340dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/terrazzo_widget_initial" />
