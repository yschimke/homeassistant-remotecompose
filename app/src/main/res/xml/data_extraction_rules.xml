<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android backs up (cloud backup) and copies to a new phone (device-to-device transfer).
  Everything not excluded here is included: the instance the app last used, its dashboard cache,
  preferences, pins and widgets, so a restored app knows the home it belongs to.

  Left out: values encrypted under an AndroidKeyStore key. Keystore keys are never backed up or
  transferred, so on the new device that ciphertext can't be decrypted. Restoring it would only
  hand the app a token it can't read (TokenVault and MobileAppStore treat that as absent, and
  covered backups made before these rules existed).
  - terrazzo_token_vault: the Home Assistant refresh token for each instance. The restored app
    asks the user to sign in again.
  - terrazzo_mobile_app: the mobile_app webhook registration. A restored phone registers as a new
    device instead of sharing the old phone's webhook.

  Cloud backups are made only when they are end-to-end encrypted (a screen lock is set).
  Device-to-device transfer is always end-to-end, so it has no such flag.

  The emulator test app-container-tests/…/BackupRestoreTest checks these rules by backing up,
  reinstalling and restoring.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="datastore/terrazzo_token_vault.preferences_pb" />
        <exclude domain="file" path="datastore/terrazzo_mobile_app.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/terrazzo_token_vault.preferences_pb" />
        <exclude domain="file" path="datastore/terrazzo_mobile_app.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
