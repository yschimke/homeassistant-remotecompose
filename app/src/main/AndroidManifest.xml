        <!--
          A launcher widget's lock or garage-door tap: runs it while the phone's controls are
          unlocked, asks first while they are locked (WidgetConfirmActivity). Reached only through
          the widget's own PendingIntent, so not exported.
        -->
        <activity
            android:name=".widget.WidgetConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Terrazzo.Translucent" />

        <!--
          AppAuth redirect receiver. Catches the `rcha://auth-callback`
          return after the HA sign-in web flow and hands the code to
          AppAuth for token exchange.
        -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true"
            tools:node="replace"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${appAuthRedirectScheme}"
                      android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!--
          Per-card home-screen widget. One declaration, many pinned
          instances — each pinned widget gets a unique `appWidgetId`
          that keys into DataStore to find its card config.
        -->
        <receiver
            android:name=".widget.TerrazzoWidgetProvider"
            android:enabled="@bool/supports_native_widgets"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/terrazzo_widget_info" />
        </receiver>

        <!-- Fires after requestPinAppWidget is confirmed by the user. -->
        <receiver
            android:name=".widget.WidgetInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ee.schimke.terrazzo.WIDGET_PIN_CONFIRMED" />
            </intent-filter>
        </receiver>

        <!-- Explicit PendingIntent endpoint for RemoteCompose launcher-widget host actions. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- Home Assistant notification buttons, card taps and "Open on watch" (notify/). -->
        <receiver
            android:name=".notify.HaNotificationActionReceiver"
            android:exported="false" />

        <!--
          AppFunctions (Android 16+): the Home Assistant functions an on-device agent with
          EXECUTE_APP_FUNCTIONS may call. The compiler generates both the service class and the
          function XML asset from assistant/TerrazzoAppFunctions.kt; every function starts
          disabled until Settings → Assistants turns them on.
        -->
        <service
            android:name=".assistant.TerrazzoAppFunctionService"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            android:exported="true"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="terrazzo_app_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_functions_metadata" />
