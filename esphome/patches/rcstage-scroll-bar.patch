+void setSideThumb(float top, float length) {
+    top = std::min(1.0f, std::max(0.0f, top));
+    length = std::min(1.0f - top, std::max(0.0f, length));
+    std::lock_guard<std::mutex> g(sLock);
+    if (top == sThumbTop && length == sThumbLength) return;
+    sThumbTop = top, sThumbLength = length;
+    sNavChanged = true;   // drawn again, as the navigation bar is
+}
+
+// The scroll bar: a track down the right, above the navigation bar, and its thumb.
+static void addSideBar(kobentovg::ThorvgPaintContext& pc, int rw, int rh) {
+    if (sSideWidth.load() <= 0) return;
+    float top, length;
+    {
+        std::lock_guard<std::mutex> g(sLock);
+        top = sThumbTop, length = sThumbLength;
+    }
+    const float k = kDensity * rw / board::kWidth;
+    const float x = rw - sSideWidth.load() * k, h = rh - sNavHeight.load() * k, w = rw - x;
+    auto bg = tvg::Shape::gen();
+    bg->appendRect(x, 0, w, h);
+    bg->fill(24, 26, 32, 255);
+    pc.addOverlay(bg);
+    if (length >= 1.0f) return;   // all of it shows: nothing to scroll
+    const float m = 6 * k, tw = w - 2 * m, inner = h - 2 * m;
+    auto thumb = tvg::Shape::gen();
+    thumb->appendRect(x + m, m + top * inner, tw, std::max(tw, length * inner), tw / 2, tw / 2);
+    thumb->fill(3, 169, 244, 200);
+    pc.addOverlay(thumb);
+}
