+void ThorvgPaintContext::drawDirect() {
+    mDirectUs = 0;
+    if (mDirect.empty() || sBitmapSource == nullptr) return;
+    const auto t0 = std::chrono::steady_clock::now();
+    const Rect full{0, 0, mW, mH};
+    std::vector<std::pair<tvg::Paint*, uint8_t>> hidden;
+    auto drawOnly = [&](size_t cut, bool keepBefore, const Rect& a) {
+        hidden.clear();
+        for (auto* p : mCanvas->paints()) hideLeaves(p, cut, !keepBefore, hidden);
+        mCanvas->viewport(a.x0, a.y0, a.x1 - a.x0, a.y1 - a.y0);
+        mCanvas->draw(false);
+        mCanvas->sync();
+        for (auto& h : hidden) h.first->opacity(h.second);
+    };
+    constexpr int kCorner = 24;   // the largest corner radius kept
+    std::vector<uint32_t> corners;
+    for (auto& pic : mDirect) {
+        const Rect box{pic.box[0], pic.box[1], pic.box[2], pic.box[3]};
+        for (auto& r : mDrawn) {
+            const Rect a = intersect(intersect(box, r), full);
+            if (a.empty()) continue;
+            // What's under the picture and its placeholder, without what's over it.
+            drawOnly(pic.seq, true, a);
+            // The corners: what the placeholder didn't cover there is kept.
+            const int cx[2] = {box.x0, std::max(box.x0, box.x1 - kCorner)};
+            const int cy[2] = {box.y0, std::max(box.y0, box.y1 - kCorner)};
+            corners.assign((size_t) 4 * kCorner * kCorner, 0);
+            // A corner the placeholder fills (a pixel in from it is the placeholder's) is square:
+            // nothing to keep there. Its straight edges blend with what's beside them when the box
+            // isn't on whole pixels, which isn't a rounded corner.
+            bool rounded[4];
+            for (int i = 0; i < 4; i++) {
+                const int x = (i & 1) ? box.x1 - 2 : box.x0 + 1, y = (i >> 1) ? box.y1 - 2 : box.y0 + 1;
+                rounded[i] = x >= a.x0 && x < a.x1 && y >= a.y0 && y < a.y1 && mPixels[y * mW + x] != kPlaceholder;
+            }
+            auto cornerRect = [&](int i) {
+                if (!rounded[i]) return Rect{};
+                const Rect c{cx[i & 1], cy[i >> 1], std::min(box.x1, cx[i & 1] + kCorner),
+                             std::min(box.y1, cy[i >> 1] + kCorner)};
+                return intersect(c, a);
+            };
+            for (int i = 0; i < 4; i++) {
+                const Rect c = cornerRect(i);
+                for (int y = c.y0; y < c.y1; y++)
+                    for (int x = c.x0; x < c.x1; x++)
+                        corners[(size_t) i * kCorner * kCorner + (y - c.y0) * kCorner + (x - c.x0)] = mPixels[y * mW + x];
+            }
+            const int within[4] = {a.x0, a.y0, a.x1, a.y1};
+            sBitmapSource->drawPicture(pic.url, pic.version, pic.box, within, mPixels, mW);
+            for (int i = 0; i < 4; i++) {
+                const Rect c = cornerRect(i);
+                for (int y = c.y0; y < c.y1; y++)
+                    for (int x = c.x0; x < c.x1; x++) {
+                        const uint32_t was = corners[(size_t) i * kCorner * kCorner + (y - c.y0) * kCorner + (x - c.x0)];
+                        if (was != kPlaceholder) mPixels[y * mW + x] = was;
+                    }
+            }
+            // What the document paints over it.
+            drawOnly(pic.seq, false, a);
+        }
+    }
+    mDirectUs = (long) std::chrono::duration_cast<std::chrono::microseconds>(
+                    std::chrono::steady_clock::now() - t0).count();
 }
 
