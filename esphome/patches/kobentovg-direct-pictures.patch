+// Leaves under [p] made invisible for a draw: those pushed up to [cut] ([before]), or after it.
+// A leaf the frame added itself (its background) counts as before everything.
+void ThorvgPaintContext::hideLeaves(tvg::Paint* p, size_t cut, bool before,
+                                    std::vector<std::pair<tvg::Paint*, uint8_t>>& hidden) {
+    if (p->type() == tvg::Type::Scene) {
+        for (auto* child : static_cast<tvg::Scene*>(p)->paints()) hideLeaves(child, cut, before, hidden);
+        return;
+    }
+    auto it = mSeq.find(p);
+    const size_t seq = it == mSeq.end() ? 0 : it->second;
+    if ((seq <= cut) != before || p->opacity() == 0) return;
+    hidden.emplace_back(p, p->opacity());
+    p->opacity(0);
+}
