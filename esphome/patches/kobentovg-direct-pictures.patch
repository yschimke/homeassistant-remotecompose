+void ThorvgPaintContext::urlDirect(int imageId, float l, float t, float r, float b) {
+    // The box in target pixels: the document's transform (no rotation in a card) maps it.
+    const tvg::Matrix& m = mMatrix;
+    const float x0 = m.e11 * l + m.e12 * t + m.e13, y0 = m.e21 * l + m.e22 * t + m.e23;
+    const float x1 = m.e11 * r + m.e12 * b + m.e13, y1 = m.e21 * r + m.e22 * b + m.e23;
+    DirectPicture pic;
+    pic.box[0] = (int) std::lround(std::min(x0, x1)), pic.box[1] = (int) std::lround(std::min(y0, y1));
+    pic.box[2] = (int) std::lround(std::max(x0, x1)), pic.box[3] = (int) std::lround(std::max(y0, y1));
+    const int w = pic.box[2] - pic.box[0], h = pic.box[3] - pic.box[1];
+    if (w <= 0 || h <= 0) return;
+    pic.url = mImageUrls[imageId];
+    pic.version = sBitmapSource->pictureVersion(pic.url, w, h);
+    // The placeholder: what shows until the host has the picture, and where it goes. Its id is
+    // the picture's, so a new one is damage.
+    auto s = tvg::Shape::gen();
+    s->appendRect(l, t, r - l, b - t);
+    s->fill((kPlaceholder >> 16) & 0xFF, (kPlaceholder >> 8) & 0xFF, kPlaceholder & 0xFF, 255);
+    size_t hash = std::hash<std::string>()(pic.url);
+    s->id = (uint32_t) (hash ^ (pic.version * 2654435761u)) | 1u;
+    push(s);
+    pic.seq = mSeqNext;
+    if (pic.version != 0) mDirect.push_back(std::move(pic));
+}
