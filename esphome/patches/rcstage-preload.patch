+
+// Player task, while idle: one step of laying a document out ahead. True when it did one.
+static bool aheadStep() {
+    std::vector<uint8_t> doc;
+    std::string name;
+    bool fit = false;
+    std::vector<std::pair<std::string, std::string>> values;
+    {
+        std::lock_guard<std::mutex> g(sLock);
+        if (sHaveAhead) {
+            doc = std::move(sAheadDoc);
+            name = std::move(sAheadName);
+            fit = sAheadFit;
+            values = std::move(sAheadValues);
+            sHaveAhead = false;
+        }
+    }
+    if (!name.empty()) {
+        if (name == sPlayer.name && sPlayer.bytes && *sPlayer.bytes == doc) return false;   // showing
+        if (sAhead.doc && sAhead.name == name && sAhead.bytes && *sAhead.bytes == doc) return false;   // laid out
+        sAhead = Player{};   // the one before: dropped first, for its memory
+        if (heap_caps_get_free_size(MALLOC_CAP_SPIRAM) < kAheadRoom + doc.size() * 8) return false;
+        const int64_t t0 = esp_timer_get_time();
+        if (!sAhead.load(std::move(doc), name.c_str(), sBufs[sBack], fit, true)) {
+            sAhead = Player{};
+            return true;
+        }
+        for (auto& [n, v] : sNamedValues) sAhead.setNamed(n, v);
+        for (auto& [n, v] : values) sAhead.setNamed(n, v);
+        ESP_LOGD(TAG, "ahead: '%s' loaded in %d ms", name.c_str(), (int) ((esp_timer_get_time() - t0) / 1000));
+        return true;
+    }
+    if (!sAhead.doc || sAhead.preroll <= 0) return false;
+    const float k = kDensity / sRenderDiv, ks = k * sAhead.scale;
+    const tvg::Matrix base{ks, 0, k * sAhead.ox, 0, ks, k * sAhead.oy, 0, 0, 1};
+    sAhead.pc->beginFrame(base, sAhead.fit ? 0xFF000000 : 0xFFFFFFFF);
+    try {
+        sAhead.doc->paint(*sAhead.ctx, kThemeLight);
+    } catch (const std::exception& e) {
+        ESP_LOGE(TAG, "ahead paint threw: %s", e.what());
+        sAhead = Player{};
+        return true;
+    }
+    if (--sAhead.preroll == 0) sAhead.doc->resetAnimationClock();
+    return true;
+}
