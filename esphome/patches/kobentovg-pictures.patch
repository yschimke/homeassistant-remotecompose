+ThorvgPaintContext::Image* ThorvgPaintContext::urlImage(int imageId, float l, float t, float r, float b) {
+    if (sBitmapSource == nullptr) return nullptr;
+    // The box in target pixels: the document's transform (no rotation in a card) scales it.
+    const float sx = std::sqrt(mMatrix.e11 * mMatrix.e11 + mMatrix.e21 * mMatrix.e21);
+    const float sy = std::sqrt(mMatrix.e12 * mMatrix.e12 + mMatrix.e22 * mMatrix.e22);
+    const int w = (int) std::lround((r - l) * sx), h = (int) std::lround((b - t) * sy);
+    if (w <= 0 || h <= 0) return nullptr;
+    const uint32_t had = mImageUrlVersions[imageId];
+    uint32_t version = had;
+    std::vector<uint32_t> px;
+    int pw = 0, ph = 0;
+    if (sBitmapSource->picture(mImageUrls[imageId], w, h, version, px, pw, ph) && version != had &&
+        pw > 0 && ph > 0 && px.size() >= (size_t) pw * ph) {
+        Image& img = mImages[imageId];
+        img.px = std::move(px);   // the old pixels go here, the new ones are the only copy
+        img.w = pw, img.h = ph;
+        img.version++;
+        mImageUrlVersions[imageId] = version;
+    }
+    return imageFor(imageId);
+}
