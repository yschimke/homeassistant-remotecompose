+// The byte offset of UTF-16 index `index` in `s` (a document's text indices count UTF-16 units).
+inline size_t byteOffset(const std::string& s, int index) {
+    size_t pos = 0;
+    int units = 0;
+    while (pos < s.size() && units < index) {
+        const unsigned char c = (unsigned char) s[pos];
+        const int len = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
+        units += len == 4 ? 2 : 1;
+        pos += len;
+    }
+    return std::min(pos, s.size());
+}
+inline int utf16Length(const std::string& s) {
+    int units = 0;
+    for (size_t pos = 0; pos < s.size();) {
+        const unsigned char c = (unsigned char) s[pos];
+        const int len = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
+        units += len == 4 ? 2 : 1;
+        pos += len;
+    }
+    return units;
+}
+// The text [start, end) as the reference slices it: an end past the text or negative is its end.
+inline std::string slice(const std::string& text, int start, int end) {
+    const int n = utf16Length(text);
+    start = std::max(0, std::min(start, n));
+    if (end < 0 || end > n) end = n;
+    end = std::max(end, start);
+    const size_t a = byteOffset(text, start), b = byteOffset(text, end);
+    return text.substr(a, b - a);
+}
+inline size_t charLength(const std::string& s, size_t pos) {
+    const unsigned char c = (unsigned char) s[pos];
+    return c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
+}
+struct Bounds { float left = 0, top = 1000, right = 0, bottom = -3.4e38f; };
+// measureBitmapText (kerned) or the anchored draw's measure (not kerned).
+inline Bounds measure(const BitmapFontDataOp& font, const std::string& text, float spacing, bool kerned) {
+    Bounds b;
+    std::string previous;
+    for (size_t pos = 0; pos < text.size();) {
+        const auto* g = font.lookup(text, pos);
+        if (!g) { pos += charLength(text, pos); previous.clear(); continue; }
+        pos += g->chars.size();
+        b.right += g->marginLeft + g->marginRight;
+        if (g->bitmapId != -1) b.right += g->width;
+        if (kerned) b.right += font.kern(previous, g->chars);
+        b.top = std::min(b.top, (float) g->marginTop);
+        b.bottom = std::max(b.bottom, (float) (g->height + g->marginTop + g->marginBottom));
+        previous = g->chars;
+        b.right += spacing;
+    }
+    return b;
+}
+// layoutBitmapTextRun: each glyph's image and where it goes.
+inline void layoutRun(const BitmapFontDataOp& font, const std::string& text, float x, float y, float spacing,
+                      std::vector<PaintContext::BitmapGlyph>& out) {
+    std::string previous;
+    for (size_t pos = 0; pos < text.size();) {
+        const auto* g = font.lookup(text, pos);
+        if (!g) { pos += charLength(text, pos); previous.clear(); continue; }
+        pos += g->chars.size();
+        if (g->bitmapId == -1) {
+            x += g->marginLeft + g->marginRight;
+            previous = g->chars;
+            continue;
+        }
+        x += g->marginLeft + font.kern(previous, g->chars);
+        out.push_back({g->bitmapId, x, y + g->marginTop, (float) g->width, (float) g->height});
+        x += g->width + g->marginRight + spacing;
+        previous = g->chars;
+    }
+}
+inline const BitmapFontDataOp* font(RemoteContext& context, int id) {
+    auto it = context.mBitmapFonts.find(id);
+    return it == context.mBitmapFonts.end() ? nullptr : it->second;
+}
