+void ThorvgPaintContext::collectLeaves(tvg::Paint* p, uint64_t ctx, Rect clip, float pad, tvg::Scene* parent) {
+    uint64_t h = hmix(ctx, ((uint64_t) p->opacity() << 32) | p->id);
+    h = hbytes(h, &p->transform(), sizeof(tvg::Matrix));
+    if (auto c = p->clip()) {
+        h = hmix(h, hashLeaf(c));
+        h = hbytes(h, &c->transform(), sizeof(tvg::Matrix));
+        clip = intersect(clip, boxOf(c, 0));
+    }
+    const tvg::Paint* mt = nullptr;
+    const auto mm = p->mask(&mt);
+    if (mm != tvg::MaskMethod::None && mt) {
+        // The mask's own content: hashed as leaves under this paint's context.
+        h = hmix(h, (uint64_t) mm);
+        const size_t before = mLeaves.size();
+        collectLeaves(const_cast<tvg::Paint*>(mt), h, clip, pad, nullptr);
+        for (size_t i = before; i < mLeaves.size(); i++) h = hmix(h, mLeaves[i].hash);
+        mLeaves.resize(before);
+    }
+    if (clip.empty()) return;   // clipped away: draws nothing
+    if (p->type() == tvg::Type::Scene) {
+        for (auto& e : mEffectPad)
+            if (e.first == p) pad += e.second;
+        auto* scene = static_cast<tvg::Scene*>(p);
+        for (auto* child : scene->paints()) collectLeaves(child, h, clip, pad, scene);
+        return;
+    }
+    const uint64_t leaf = hashLeaf(p);
+    // Unreadable content changes every frame: a hash no other frame shares.
+    h = leaf ? hmix(h, leaf) : hmix(h, 0xdead0000ull + mFrame);
+    float extra = pad;
+    if (p->type() == tvg::Type::Shape) {
+        const float sw = static_cast<tvg::Shape*>(p)->strokeWidth();
+        if (sw > 0) {
+            const auto& m = p->transform();
+            const float scale = std::sqrt(std::fabs(m.e11 * m.e22 - m.e12 * m.e21));
+            extra += sw * scale * 2;   // miter joins reach past half the width
+        }
+    }
+    const Rect box = intersect(boxOf(p, extra), clip);
+#if !defined(ESP_PLATFORM)
+    if (!leaf && std::getenv("RC_DAMAGE_DEBUG"))
+        std::printf("    volatile type=%d [%d,%d %dx%d]\n", (int) p->type(), box.x0, box.y0, box.x1 - box.x0, box.y1 - box.y0);
+#endif
+    if (!box.empty()) mLeaves.push_back({h, box, p, parent});
+}
+
+void ThorvgPaintContext::drawDamaged() {
+    const auto t0 = std::chrono::steady_clock::now();
+    const Rect full{0, 0, mW, mH};
+    mLeaves.clear();
+    for (auto* p : mCanvas->paints()) collectLeaves(p, 0, full, 0, nullptr);
+    std::sort(mLeaves.begin(), mLeaves.end(),
+              [](const Leaf& a, const Leaf& b) { return a.hash < b.hash; });
+
+    // What changed: every leaf of either frame that the other doesn't have (as a multiset).
+    // Unchanged paints over a changed area are redrawn with it: the viewport draws all.
+    mFrameDamage.clear();
+    std::vector<Rect> raw;
+    long rawArea = 0;
+    if (mPrevLeaves.empty()) raw.push_back(full);
+    size_t i = 0, j = 0;
+    while (raw.size() < 4096 && (i < mPrevLeaves.size() || j < mLeaves.size())) {
+        if (j >= mLeaves.size() || (i < mPrevLeaves.size() && mPrevLeaves[i].hash < mLeaves[j].hash)) {
+            raw.push_back(mPrevLeaves[i++].box);
+        } else if (i >= mPrevLeaves.size() || mLeaves[j].hash < mPrevLeaves[i].hash) {
+            raw.push_back(mLeaves[j++].box);
+        } else {
+            i++;
+            j++;
+        }
+    }
+    for (auto& r : raw) rawArea += r.area();
+#if !defined(ESP_PLATFORM)
+    if (std::getenv("RC_DAMAGE_DEBUG")) {
+        std::printf("  damage: %zu leaves, %zu changed, area %ld\n", mLeaves.size(), raw.size(), rawArea);
+        for (auto& r : raw) if (r.area() > 20000) std::printf("    big [%d,%d %dx%d]\n", r.x0, r.y0, r.x1 - r.x0, r.y1 - r.y0);
+    }
+#endif
+    if (rawArea >= full.area() / 2 || raw.size() >= 4096) mFrameDamage.assign(1, full);
+    else for (auto& r : raw) addRect(mFrameDamage, r, 4);
+    std::swap(mPrevLeaves, mLeaves);
+
+    // Each buffer's backlog gains this frame's damage; the target's is drawn and cleared.
+    std::vector<Rect>* own = nullptr;
+    for (auto& b : mBacklog) {
+        for (auto& r : mFrameDamage) addRect(b.second, r, 4);
+        if (b.first == mPixels) own = &b.second;
+    }
+    if (!own) {
+        mBacklog.emplace_back(mPixels, std::vector<Rect>{full});
+        own = &mBacklog.back().second;
+    }
+    mDrawn = std::move(*own);
+    own->clear();
+
+    // A paint that touches none of it draws nothing this frame, but ThorVG would still
+    // prepare it (outline, stroke, RLE) before finding it outside the viewport: drop it.
+    // (The leaves are this frame's: mLeaves and mPrevLeaves were swapped above.)
+    long drawnArea = 0;
+    for (auto& r : mDrawn) drawnArea += r.area();
+    // Off: removing (and so freeing) paints from their scenes mid-frame is the prime suspect for
+    // the panel's corrupted span lists (crashes rasterising a shape after a screen change);
+    // RC_CULL=1 (host) turns it back on to compare.
+#if defined(ESP_PLATFORM)
+    constexpr bool cull = false;
+#else
+    static const bool cull = std::getenv("RC_CULL") != nullptr;
+#endif
+    if (cull && drawnArea < full.area()) {
+        for (auto& leaf : mPrevLeaves) {
+            bool touches = false;
+            for (auto& r : mDrawn) touches = touches || !intersect(leaf.box, r).empty();
+            if (touches || !leaf.paint) continue;
+            if (leaf.parent) leaf.parent->remove(leaf.paint);
+            else mCanvas->remove(leaf.paint);
+        }
+    }
+    for (auto& leaf : mPrevLeaves) leaf.paint = nullptr, leaf.parent = nullptr;
+    mDiffUs = (long) std::chrono::duration_cast<std::chrono::microseconds>(
+                  std::chrono::steady_clock::now() - t0).count();
+
+    for (auto& r : mDrawn) {
+        mCanvas->viewport(r.x0, r.y0, r.x1 - r.x0, r.y1 - r.y0);
+        mCanvas->draw(false);
+        mCanvas->sync();
+    }
+}
