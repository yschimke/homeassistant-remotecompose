+// ── Damage tracking ───────────────────────────────────────────────────────────────────────
+
+static inline uint64_t hmix(uint64_t h, uint64_t v) {
+    h ^= v + 0x9e3779b97f4a7c15ull + (h << 6) + (h >> 2);
+    return h * 0xff51afd7ed558ccdull;
+}
+
+static uint64_t hbytes(uint64_t h, const void* data, size_t n) {
+    auto p = static_cast<const uint8_t*>(data);
+    size_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        uint64_t v;
+        std::memcpy(&v, p + i, 8);
+        h = hmix(h, v);
+    }
+    uint64_t tail = 0;
+    if (i < n) std::memcpy(&tail, p + i, n - i);
+    return hmix(h, tail ^ n);
+}
+
+static uint32_t trimId(float start, float end) {
+    uint32_t a, b;
+    std::memcpy(&a, &start, 4);
+    std::memcpy(&b, &end, 4);
+    return (a * 2654435761u) ^ (b * 40503u) ^ 1u;
+}
+
+static uint64_t hashFill(uint64_t h, const tvg::Fill* f) {
+    if (!f) return hmix(h, 0x11);
+    h = hmix(h, (uint64_t) f->type());
+    const tvg::Fill::ColorStop* stops = nullptr;
+    const uint32_t n = f->colorStops(&stops);
+    if (n && stops) h = hbytes(h, stops, sizeof(*stops) * n);
+    h = hmix(h, (uint64_t) f->spread());
+    h = hbytes(h, &f->transform(), sizeof(tvg::Matrix));
+    float v[6] = {};
+    if (f->type() == tvg::Type::LinearGradient)
+        static_cast<const tvg::LinearGradient*>(f)->linear(&v[0], &v[1], &v[2], &v[3]);
+    else if (f->type() == tvg::Type::RadialGradient)
+        static_cast<const tvg::RadialGradient*>(f)->radial(&v[0], &v[1], &v[2], &v[3], &v[4], &v[5]);
+    return hbytes(h, v, sizeof(v));
+}
+
+// What a leaf paint draws, apart from its transform, opacity and clip (hashed by the caller).
+// 0 = it can't be read back (a Picture or Text without an id): always redrawn.
+static uint64_t hashLeaf(const tvg::Paint* p) {
+    uint64_t h = hmix(0x6a09e667f3bcc909ull, (uint64_t) p->type());
+    switch (p->type()) {
+        case tvg::Type::Shape: {
+            auto s = static_cast<const tvg::Shape*>(p);
+            const tvg::PathCommand* cmds = nullptr;
+            const tvg::Point* pts = nullptr;
+            uint32_t nc = 0, np = 0;
+            s->path(&cmds, &nc, &pts, &np);
+            if (nc) h = hbytes(h, cmds, sizeof(*cmds) * nc);
+            if (np) h = hbytes(h, pts, sizeof(*pts) * np);
+            uint8_t c[4] = {};
+            if (auto f = s->fill()) h = hashFill(h, f);
+            else { s->fill(&c[0], &c[1], &c[2], &c[3]); h = hbytes(h, c, 4); }
+            h = hmix(h, (uint64_t) s->fillRule());
+            const float sw = s->strokeWidth();
+            h = hbytes(h, &sw, 4);
+            if (sw > 0) {
+                if (auto f = s->strokeFill()) h = hashFill(h, f);
+                else { s->strokeFill(&c[0], &c[1], &c[2], &c[3]); h = hbytes(h, c, 4); }
+                const float* dash = nullptr;
+                float off = 0;
+                const uint32_t nd = s->strokeDash(&dash, &off);
+                if (nd && dash) h = hbytes(h, dash, sizeof(float) * nd);
+                h = hbytes(h, &off, 4);
+                h = hmix(h, ((uint64_t) s->strokeCap() << 8) | (uint64_t) s->strokeJoin());
+                const float ml = s->strokeMiterlimit();
+                h = hbytes(h, &ml, 4);
+            }
+            return h;
+        }
+        case tvg::Type::Picture: {
+            if (!p->id) return 0;
+            float w = 0, hh = 0;
+            static_cast<const tvg::Picture*>(p)->size(&w, &hh);
+            float wh[2] = {w, hh};
+            return hbytes(h, wh, sizeof(wh));
+        }
+        default:
+            return 0;
+    }
+}
