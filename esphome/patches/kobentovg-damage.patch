+// ── A font's character map (TrueType `cmap`, formats 4 and 12), for faceHas ──────────────
+
+static uint32_t be16(const uint8_t* p) { return (uint32_t) p[0] << 8 | p[1]; }
+static uint32_t be32(const uint8_t* p) { return be16(p) << 16 | be16(p + 2); }
+
+// The subtable a face's code points are looked up in: its offset in the font, 0 for none.
+static size_t cmapSubtable(const uint8_t* f, size_t n) {
+    if (n < 12) return 0;
+    const uint32_t tables = be16(f + 4);
+    for (uint32_t i = 0; i < tables && 12 + 16 * (i + 1) <= n; i++) {
+        const uint8_t* rec = f + 12 + 16 * i;
+        if (std::memcmp(rec, "cmap", 4) != 0) continue;
+        const size_t cmap = be32(rec + 8);
+        if (cmap + 4 > n) return 0;
+        size_t best = 0;
+        int bestRank = 0;
+        for (uint32_t k = 0, m = be16(f + cmap + 2); k < m && cmap + 4 + 8 * (k + 1) <= n; k++) {
+            const uint8_t* e = f + cmap + 4 + 8 * k;
+            const size_t sub = cmap + be32(e + 4);
+            if (sub + 2 > n) continue;
+            const uint32_t format = be16(f + sub), platform = be16(e), encoding = be16(e + 2);
+            // Full Unicode (format 12) beats the basic plane (format 4).
+            const int rank = format == 12 && (platform == 0 || encoding == 10) ? 2
+                             : format == 4 && (platform == 0 || encoding == 1) ? 1 : 0;
+            if (rank > bestRank) bestRank = rank, best = sub;
+        }
+        return best;
+    }
+    return 0;
+}
+
+static bool cmapHas(const uint8_t* f, size_t n, size_t sub, uint32_t cp) {
+    if (!sub) return true;   // no map to go by: assume the face draws it, as before
+    const uint32_t format = be16(f + sub);
+    if (format == 12 && sub + 16 <= n) {
+        const uint32_t groups = be32(f + sub + 12);
+        uint32_t lo = 0, hi = groups;
+        while (lo < hi) {   // groups are sorted by start code point
+            const uint32_t mid = (lo + hi) / 2;
+            const size_t g = sub + 16 + 12 * (size_t) mid;
+            if (g + 12 > n) return false;
+            if (cp < be32(f + g)) hi = mid;
+            else if (cp > be32(f + g + 4)) lo = mid + 1;
+            else return be32(f + g + 8) + (cp - be32(f + g)) != 0;
+        }
+        return false;
+    }
+    if (format == 4 && sub + 14 <= n) {
+        if (cp > 0xFFFF) return false;
+        const uint32_t segs = be16(f + sub + 6) / 2;
+        const size_t ends = sub + 14, starts = ends + 2 * segs + 2, deltas = starts + 2 * segs,
+                     ranges = deltas + 2 * segs;
+        if (ranges + 2 * segs > n) return false;
+        for (uint32_t i = 0; i < segs; i++) {
+            if (cp > be16(f + ends + 2 * i)) continue;
+            const uint32_t start = be16(f + starts + 2 * i);
+            if (cp < start) return false;
+            const uint32_t range = be16(f + ranges + 2 * i);
+            if (range == 0) return ((cp + be16(f + deltas + 2 * i)) & 0xFFFF) != 0;
+            const size_t at = ranges + 2 * i + range + 2 * (cp - start);
+            return at + 2 <= n && be16(f + at) != 0;
+        }
+    }
+    return false;
+}
+
+bool ThorvgPaintContext::faceHas(Face face, uint32_t cp) {
+    const int i = static_cast<int>(face);
+    if (i < 0 || i > 2 || !sFaceData[i]) return i <= 2;
+    static size_t sub[3] = {SIZE_MAX, SIZE_MAX, SIZE_MAX};
+    if (sub[i] == SIZE_MAX) sub[i] = cmapSubtable(sFaceData[i], sFaceSize[i]);
+    return cmapHas(sFaceData[i], sFaceSize[i], sub[i], cp);
+}
