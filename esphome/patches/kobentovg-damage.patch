+    if (p->bounds(q) != tvg::Result::Success) return Rect{0, 0, mW, mH};
+    float x0 = q[0].x, y0 = q[0].y, x1 = q[0].x, y1 = q[0].y;
+    for (int i = 1; i < 4; i++) {
+        x0 = std::min(x0, q[i].x); x1 = std::max(x1, q[i].x);
+        y0 = std::min(y0, q[i].y); y1 = std::max(y1, q[i].y);
+    }
+    if (!std::isfinite(x0) || !std::isfinite(y0) || !std::isfinite(x1) || !std::isfinite(y1))
+        return Rect{0, 0, mW, mH};
+    // A pixel of antialiasing either side, and whatever reaches past the geometry.
+    pad += 2;
+    Rect r{(int) std::floor(x0 - pad), (int) std::floor(y0 - pad), (int) std::ceil(x1 + pad),
+           (int) std::ceil(y1 + pad)};
+    r.x0 = std::max(r.x0, 0); r.y0 = std::max(r.y0, 0);
+    r.x1 = std::min(r.x1, mW); r.y1 = std::min(r.y1, mH);
+    return r;
+}
+
+static ThorvgPaintContext::Rect intersect(const ThorvgPaintContext::Rect& a,
+                                          const ThorvgPaintContext::Rect& b) {
+    return {std::max(a.x0, b.x0), std::max(a.y0, b.y0), std::min(a.x1, b.x1), std::min(a.y1, b.y1)};
+}
+
+static ThorvgPaintContext::Rect unite(const ThorvgPaintContext::Rect& a,
+                                      const ThorvgPaintContext::Rect& b) {
+    return {std::min(a.x0, b.x0), std::min(a.y0, b.y0), std::max(a.x1, b.x1), std::max(a.y1, b.y1)};
+}
+
+// Add `r` to a short list of rectangles, merging where the union costs little extra area,
+// and keeping at most `cap` (the cheapest pair merged first).
+static void addRect(std::vector<ThorvgPaintContext::Rect>& list, ThorvgPaintContext::Rect r, size_t cap) {
+    if (r.empty()) return;
+    for (bool merged = true; merged;) {
+        merged = false;
+        for (size_t i = 0; i < list.size(); i++) {
+            auto u = unite(list[i], r);
+            if (u.area() <= list[i].area() + r.area() + 2048) {
+                r = u;
+                list.erase(list.begin() + (long) i);
+                merged = true;
+                break;
+            }
+        }
+    }
+    list.push_back(r);
+    while (list.size() > cap) {
+        size_t bi = 0, bj = 1;
+        long best = -1;
+        for (size_t i = 0; i < list.size(); i++)
+            for (size_t j = i + 1; j < list.size(); j++) {
+                long grow = unite(list[i], list[j]).area() - list[i].area() - list[j].area();
+                if (best < 0 || grow < best) { best = grow; bi = i; bj = j; }
+            }
+        auto u = unite(list[bi], list[bj]);
+        list.erase(list.begin() + (long) bj);
+        list.erase(list.begin() + (long) bi);
+        addRect(list, u, cap);
+    }
+}
