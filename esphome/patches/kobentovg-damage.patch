+// Room for a text-run image of [bytes]: past the cache's budget, runs not drawn this frame go
+// first (the last frame's scene is gone by now, so nothing else points at them). A layout that
+// settles over a few frames draws its text at a new phase each frame; keeping two frames of runs
+// as before held two or three screens of text at once, more than the panel's PSRAM. False, and
+// the run waits a frame, when even then no block takes it with ThorVG's working room to spare.
+bool ThorvgPaintContext::makeTextRoom(size_t bytes, const std::string& utf8) {
+    constexpr size_t kBudget = 64u << 10;
+    // No run on an 800x480 screen is a quarter of a megabyte: one that is has a size or width
+    // gone astray, and allowing it took the heap.
+    if (bytes > (256u << 10)) {
+        static int logged = 0;
+        if (logged++ < 8) {
+#if defined(ESP_PLATFORM)
+            ESP_LOGW("kobentovg", "text run '%.24s' needs %u KB: not drawn", utf8.c_str(), (unsigned) (bytes >> 10));
+            char note[64];
+            snprintf(note, sizeof(note), "run '%.16s' %u KB", utf8.c_str(), (unsigned) (bytes >> 10));
+            tvg_note(note);
+#else
+            std::fprintf(stderr, "text run '%.24s' needs %u KB: not drawn\n", utf8.c_str(), (unsigned) (bytes >> 10));
+#endif
+        }
+        return false;
+    }
+    if (mTextImageBytes + bytes > kBudget) {
+        for (auto e = mTextImages.begin(); e != mTextImages.end();) {
+            if (e->second.usedFrame != mFrame) {
+                mTextImageBytes -= e->second.px.size() * 4;
+                e = mTextImages.erase(e);
+            } else {
+                ++e;
+            }
+        }
+    }
+#if defined(ESP_PLATFORM)
+    // Room for it and some to spare, asked by a trial allocation: heap_caps_get_largest_free_block
+    // walks the heap with interrupts off (2.6 ms on the LCD-7), and the panel's scan-out slips.
+    void* trial = heap_caps_malloc(bytes + (32u << 10), MALLOC_CAP_SPIRAM);
+    if (trial == nullptr) {
+        ESP_LOGW("kobentovg", "text run '%.24s' (%u B) waits: no %u KB block of PSRAM", utf8.c_str(),
+                 (unsigned) bytes, (unsigned) ((bytes >> 10) + 32));
+        return false;
+    }
+    heap_caps_free(trial);
+#else
+    (void) utf8;
+    // RC_TEXT_ROOM_FAIL=N: every Nth run finds no room, as on a panel short of PSRAM.
+    static const int failEvery = std::getenv("RC_TEXT_ROOM_FAIL") ? std::atoi(std::getenv("RC_TEXT_ROOM_FAIL")) : 0;
+    static int calls = 0;
+    if (failEvery > 0 && ++calls % failEvery == 0) return false;
+#endif
+    return true;
