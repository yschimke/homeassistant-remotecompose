<?xml version="1.0" encoding="utf-8"?>
<!--
  Glance Wear widget provider descriptor — large container variant, for
  CardLargeWidgetService. Every placed widget shows its own card, chosen on
  the watch (WearWidgetConfigActivity, or the Terrazzo app's Widgets screen)
  from the cards the phone shows on the watch, and resolved at render time
  from WearWidgetCardStore by the widget's instance id.

  previewImage is a placeholder vector for now — a follow-up renders
  the wear @Preview functions to PNG and wires the rendered drawables
  in here.
-->
<wearwidget-provider
    label="Terrazzo"
    description="Shows a Home Assistant card. Choose which one on your phone, under Widgets."
    preferredType="@integer/glance_wear_container_type_large"
    previewImage="@drawable/wear_slot_preview_large">
    <container
        type="@integer/glance_wear_container_type_large"
        previewImage="@drawable/wear_slot_preview_large" />
</wearwidget-provider>
