<?xml version="1.0" encoding="utf-8"?>
<!--
  Glance Wear widget provider descriptor — small container variant, for
  CardSmallWidgetService. Every placed widget shows its own card, chosen on
  the watch (WearWidgetConfigActivity, or the Terrazzo app's Widgets screen)
  from the cards the phone shows on the watch, and resolved at render time
  from WearWidgetCardStore by the widget's instance id.

  Schema is parsed by androidx.glance.wear.core.WearWidgetProviderInfoXmlParser;
  attribute / tag names match its TAG_PROVIDER and ATTR_* constants.

  previewImage (drawable-nodpi/wear_slot_preview_small.png) is the
  WearEntitySmall @Preview (CardSlotWidgetPreviews.kt), rendered with
  compose-preview (the :wear module) and cropped to the widget on a transparent background.
-->
<wearwidget-provider
    label="Terrazzo"
    description="Shows a Home Assistant card. Choose which one on your phone, under Widgets."
    preferredType="@integer/glance_wear_container_type_small"
    previewImage="@drawable/wear_slot_preview_small">
    <container
        type="@integer/glance_wear_container_type_small"
        previewImage="@drawable/wear_slot_preview_small" />
</wearwidget-provider>
