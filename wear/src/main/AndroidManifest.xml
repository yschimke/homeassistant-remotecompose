        </service>

        <!-- Slot 4 -->
        <service
            android:name=".widget.Slot3SmallWidgetService"
            android:exported="true"
            android:enabled="false"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER"
            android:label="Terrazzo slot 4 (small)">
            <intent-filter>
