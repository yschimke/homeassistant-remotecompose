        <!-- Warms the pinned cards' templates as soon as an update lands. -->
        <receiver
            android:name=".sync.WearPackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!--
          Forgets what the phone deletes from the Data Layer (sign-out, a removed dashboard)
          while the app isn't running, and redraws the widgets for new pins, sections or Wear
          designs. Exported for Play services, which delivers Data Layer
          events through this action; it wakes for the rarely written items only, never for
          /wear/values or pictures. Paths mirror WearSyncPaths.
        -->
        <service
            android:name=".sync.WearDataDeletionListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/wear/dashboard/" />
                <data android:scheme="wear" android:host="*" android:path="/wear/pinned" />
                <data android:scheme="wear" android:host="*" android:path="/wear/sections" />
                <data android:scheme="wear" android:host="*" android:path="/wear/slot-designs" />
            </intent-filter>
            <!-- The watch's own Home Assistant token, which the phone may send while the app is closed. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/wear/access" />
            </intent-filter>
        </service>

        <!--
          Picks the card a Terrazzo widget shows, from the cards the phone shows on the watch.
          The Glance Wear provider-configuration contract: the PROVIDER_CONFIG category plus
          DEFAULT, launched with the widget's instance id and provider component (see
          GlanceWearWidget.EXTRA_CONFIG_WIDGET_ID / EXTRA_CONFIG_PROVIDER_COMPONENT). Whether a
          widget host launches it when a widget is added is up to the host; the Terrazzo app's
          Widgets screen opens the same picker. Exported so the host can start it.
        -->
        <activity
            android:name=".widget.WearWidgetConfigActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="ee.schimke.terrazzo.wear.ACTION_CONFIGURE_WIDGET" />
                <category android:name="com.google.android.clockwork.tiles.category.PROVIDER_CONFIG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The two Terrazzo widget providers, one per Glance Wear container size: each service's
          wearwidget-provider XML declares one container type, so the system widget picker
          offers both sizes. Every placed widget shows its own card, chosen on the watch.

          Both start `android:enabled="false"`; WearWidgetsController enables them on API 37+
          while the phone shows any card on the watch. Each service binds via the Glance Wear
          native action plus the tile-provider compat action so older watch faces still see the
          same provider.

          Exported for the system's widget / tile host only: each one requires
          BIND_TILE_PROVIDER, the system permission Wear OS holds when it binds a widget or tile
          provider, so no other app can bind one and read the card it renders.

          PROVIDER_CONFIG_ACTION names the configuration activity's action, as tile providers
          do; best effort, since Glance Wear documents the activity contract but not how the
          host finds it.
        -->
        <service
            android:name=".widget.CardSmallWidgetService"
            android:exported="true"
            android:enabled="false"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER"
            android:label="Home Assistant card (small)">
            <intent-filter>
                <action android:name="androidx.glance.wear.action.BIND_WIDGET_PROVIDER" />
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.glance.wear.widget.provider"
                android:resource="@xml/wear_slot_widget_provider_small" />
            <meta-data
                android:name="com.google.android.clockwork.tiles.PROVIDER_CONFIG_ACTION"
                android:value="ee.schimke.terrazzo.wear.ACTION_CONFIGURE_WIDGET" />
        </service>
        <service
            android:name=".widget.CardLargeWidgetService"
            android:exported="true"
            android:enabled="false"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER"
            android:label="Home Assistant card (large)">
            <intent-filter>
