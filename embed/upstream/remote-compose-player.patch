@@ -0,0 +1,46 @@
+import assert from 'node:assert/strict';
+import { Operations } from './core/Operations';
+import { WireBuffer } from './core/WireBuffer';
+import { HostActionMetadataOperation } from './core/operations/layout/modifiers/ActionOperations';
+import { WebRemoteContext } from './web/WebRemoteContext';
+
+// HostActionMetadataOperation (216): the reader takes both ids, and the action hands the host the
+// metadata text as it is when the action runs — through the id-action channel.
+{
+    const data = new DataView(new ArrayBuffer(8));
+    data.setInt32(0, 7);
+    data.setInt32(4, 42);
+    const ops: any[] = [];
+    Operations.getReader(HostActionMetadataOperation.OP_CODE)!(WireBuffer.fromArrayBuffer(data.buffer), ops);
+    const op = ops[0] as HostActionMetadataOperation;
+    assert.ok(op instanceof HostActionMetadataOperation, '216 decodes to a real operation, not a stub');
+    assert.equal(op.getActionId(), 7);
+    assert.equal(op.getMetadataId(), 42);
+
+    const texts = new Map<number, string>([[42, '{"entityId":"light.kitchen"}']]);
+    const runs: Array<[number, string]> = [];
+    const ctx: any = { getText: (id: number) => texts.get(id) ?? null, runAction: (id: number, m: string) => runs.push([id, m]) };
+    op.apply(ctx);
+    texts.set(42, 'changed');
+    op.apply(ctx);
+    new HostActionMetadataOperation(8, 99).apply(ctx);
+    assert.deepEqual(runs, [[7, '{"entityId":"light.kitchen"}'], [7, 'changed'], [8, '']]);
+    console.log('host action metadata ok');
+}
+
+// A named string override is what text draws: it reaches the paint cache, and the document's own
+// TextData, re-applied on a later pass, does not put the authored text back.
+{
+    const cache = new Map<number, string>();
+    const paint: any = { loadText: (id: number, t: string) => cache.set(id, t), getText: (id: number) => cache.get(id) ?? null };
+    const ctx = new WebRemoteContext(paint);
+    ctx.loadText(59, 'Name');
+    ctx.loadVariableName('USER:light.s0.name', 59, 0);
+    ctx.setNamedStringOverride('USER:light.s0.name', 'Kitchen');
+    assert.equal(ctx.getText(59), 'Kitchen', 'the override is drawn');
+    ctx.loadText(59, 'Name');
+    assert.equal(ctx.getText(59), 'Kitchen', 'a re-applied TextData keeps the override');
+    ctx.loadText(60, 'Other');
+    assert.equal(ctx.getText(60), 'Other', 'other text still loads');
+    console.log('named string override ok');
+}
