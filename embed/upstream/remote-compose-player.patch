+// ── HostActionMetadataOperation (216): INT actionId, INT metadataId ───
+/**
+ * A numeric host action that also hands the host a string: the text `metadataId` names,
+ * resolved **when the action runs**, so a dynamic string (a merge of named variables, a
+ * formatted float) carries its current value rather than the one it had at load.
+ *
+ * Mirrors the Java reference: `apply` outside a click does nothing, a missing text is
+ * the empty string, and the host sees it through the same `runAction(id, metadata)`
+ * channel as {@link HostActionOperation} — `CoreDocument.addIdActionListener`.
+ */
+export class HostActionMetadataOperation extends Operation {
+    static readonly OP_CODE = 216;
+    private mActionId: number;
+    private mMetadataId: number;
+
+    constructor(actionId: number, metadataId: number) {
+        super();
+        this.mActionId = actionId;
+        this.mMetadataId = metadataId;
+    }
+
+    getActionId(): number { return this.mActionId; }
+    getMetadataId(): number { return this.mMetadataId; }
+
+    write(_buffer: WireBuffer): void { /* stub */ }
+
+    // Action operations run from their click modifier's list, which calls apply().
+    apply(context: RemoteContext): void {
+        context.runAction(this.mActionId, context.getText(this.mMetadataId) ?? '');
+    }
+
+    deepToString(indent: string): string {
+        return `${indent}HostActionMetadataOperation(${this.mActionId}, ${this.mMetadataId})`;
+    }
+
+    static read(buffer: WireBuffer, operations: Operation[]): void {
+        const actionId = buffer.readId();
+        const metadataId = buffer.readId();
+        operations.push(new HostActionMetadataOperation(actionId, metadataId));
+    }
+}
+
